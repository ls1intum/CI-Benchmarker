# --- Local runs only (`go run .`) -------------------------------------------
# docker-compose.yml sets both of these itself and ignores what is set here:
# the port has to agree with the `expose` entry and the Traefik loadbalancer
# label, and DB_PATH has to point inside the benchmark-data volume.

# Port the benchmarker listens on.
SERVER_ADDRESS=8080

# Where the benchmark database lives.
DB_PATH=benchmark.db

# --- docker compose ----------------------------------------------------------

# The benchmarker's own externally reachable base URL. It is handed to each
# system under test as the status callback target (CALLBACK_BASE_URL/v1/callback),
# so the SUT can report terminal status. Without it, Hades has nowhere to report
# and no job can be measured.
CALLBACK_BASE_URL=https://ci-benchmarker.example.org

# Hostname Traefik routes to. Previously hardcoded in docker-compose.yml.
BENCHMARKER_HOST=ci-benchmarker.example.org

# Image tag to run. Required - docker compose refuses to start without it.
# Use an immutable release or commit tag so the collected data records which
# build produced it. `latest` moves, and must not be used for a campaign.
BENCHMARKER_IMAGE_TAG=v0.1.0

LETSENCRYPT_EMAIL=example@tum.de

# --- Load generation ---------------------------------------------------------
# These apply to every variant identically. That is the point: a comparison is
# only meaningful if all systems under test see the same offered load.

# Maximum in-flight submissions when a request does not pass ?concurrency=.
DEFAULT_CONCURRENCY=64

# Offered submissions per second when a request does not pass ?rate=.
# 0 submits as fast as the concurrency cap allows.
DEFAULT_RATE_PER_SECOND=0

# --- Shared HTTP client ------------------------------------------------------
HTTP_TIMEOUT_SECONDS=30
HTTP_DIAL_TIMEOUT_SECONDS=10
HTTP_MAX_IDLE_CONNS_PER_HOST=1024

# 0 means unlimited, and it should stay 0. A hard per-host connection cap makes
# submission N+1 block waiting for a free connection, and that wait counts
# against the client timeout, so the cap both throttles the offered load and
# manufactures submission failures that look like the system under test failing.
HTTP_MAX_CONNS_PER_HOST=0

# --- Both --------------------------------------------------------------------

DEBUG=false
